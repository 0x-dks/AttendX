# AttendX Environment Configuration
# Copy this file to .env and fill in the values before running.

# Flask secret key for session signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-hex-string

# Teacher login password (will be hashed on first run).
# After first run, you can remove this — the hashed version is stored internally.
TEACHER_PASSWORD=attendx2026

# Set to "1" to enable Flask debug mode. Leave empty or "0" for production.
FLASK_DEBUG=0

# Set to "1" to serve over HTTPS using ad-hoc SSL certificates.
# Useful for testing mobile camera access over local Wi-Fi. Default is 0 (HTTP).
USE_HTTPS=0
